# -----------------------------------------------------------------------------
# Environment variables for Цагтаа (tsagtaa).
# Copy this file to `.env` and fill in real values:
#   Copy-Item .env.example .env
# Never commit `.env` — it is listed in .gitignore.
# -----------------------------------------------------------------------------

# --- PostgreSQL container (read by docker-compose.yml) ------------------------
POSTGRES_USER=tsagtaa
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=tsagtaa
# Host port. Change to 5433 if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432

# --- Server-only variables (never sent to the browser) ------------------------
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://tsagtaa:change-me-to-a-long-random-password@localhost:5432/tsagtaa?schema=public

# --- Public variables (inlined into the browser bundle at build time) ---------
# Anything prefixed with NEXT_PUBLIC_ is visible to every visitor. No secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Цагтаа

# NODE_ENV is set automatically by Next.js (dev → development, build/start → production).
# Do not set it here.
