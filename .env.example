# -----------------------------------------------------------------------------
# Цагтаа (tsagtaa)-гийн environment хувьсагчид.
# Энэ файлыг `.env` болгон хуулаад бодит утгуудаар бөглөнө:
#   Copy-Item .env.example .env
# `.env`-ийг хэзээ ч commit хийж болохгүй — .gitignore-д орсон.
# -----------------------------------------------------------------------------

# --- PostgreSQL контейнер (docker-compose.yml уншина) ------------------------
POSTGRES_USER=tsagtaa
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=tsagtaa
# Компьютерийн порт. Local PostgreSQL 5432-ыг ашиглаж байвал 5433 болгоно.
POSTGRES_PORT=5432

# --- Зөвхөн серверт (browser руу хэзээ ч явахгүй) ------------------------
# Дээрх POSTGRES_* утгуудтай таарах ёстой.
DATABASE_URL=postgresql://tsagtaa:change-me-to-a-long-random-password@localhost:5432/tsagtaa?schema=public

# --- Имэйлээр нэвтрэх код ---------------------------------------------------------
# Хөгжүүлэлтийн үед бүгдийг хоосон үлдээнэ: код `npm run dev`-ийн terminal-д хэвлэгдэнэ.
#
# 1-р сонголт, домэйн хэрэггүй: Gmail бүртгэл (өдөрт ~500 имэйл).
#   Google account → Security → 2-Step Verification асаах → "App passwords" → шинээр үүсгэх.
#   SMTP_PASSWORD нь тэр 16 үсэгтэй app password, Gmail-ийн нууц үг БИШ.
SMTP_USER=
SMTP_PASSWORD=
# Анхдагч утгууд Gmail-д тохирно; өөр үйлчилгээ бол сольно.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
#
# 2-р сонголт, https://resend.com дээр баталгаажуулсан өөрийн домэйн шаардана (сард 3000 үнэгүй).
# Зөвхөн SMTP_USER хоосон үед ашиглагдана.
RESEND_API_KEY=
#
# Inbox-д харагдах илгээгч. Хоосон бол: Gmail бүртгэл, эсвэл Resend-ийн туршилтын хаяг.
EMAIL_FROM=

# --- Нийтийн хувьсагчид (build хийхэд browser bundle-д шингэнэ) ---------
# NEXT_PUBLIC_-ээр эхэлсэн бүхнийг зочин бүр харж чадна. Нууц мэдээлэл энд бүү хий.
NEXT_PUBLIC_APP_URL=https://tsagtaa.vercel.app
NEXT_PUBLIC_APP_NAME=Цагтаа

# NODE_ENV-ийг Next.js өөрөө тохируулна (dev → development, build/start → production).
# Энд бүү тохируул.




